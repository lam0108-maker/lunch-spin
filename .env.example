# 附近搜尋：osm（預設）| google | mock
EXPO_PUBLIC_PLACES_PROVIDER=osm
# 僅當 provider=google 或 OSM_GOOGLE_FALLBACK=1 先會用（Places API）
EXPO_PUBLIC_GOOGLE_PLACES_API_KEY=
# 地圖揀位（Maps JavaScript API）。可留空則重用上面 Places key（同一個 Cloud key 亦可，但要啟用 Maps JavaScript API）
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_OSM_GOOGLE_FALLBACK=0
# 將軍澳本地種子庫：1=開（預設）、0=關（強制走 OSM/Google）
EXPO_PUBLIC_LOCAL_SEED=1
